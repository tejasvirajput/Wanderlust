<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <br />
      <h3>Create a New Listing</h3>
      <form
        action="/listings"
        method="POST"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-lable">Title</label>
          <input
            type="text"
            name="listing[title]"
            placeholder="Add a catchy title"
            class="form-control"
            required
          />
          <div class="valid-feedback">Title looks good!</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-lable">Description</label>
          <textarea
            name="listing[description]"
            placeholder="enter description"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a short description</div>

          <!-- AI Description Generator -->
          <button
            type="button"
            id="generateAiBtn"
            class="btn btn-outline-primary mt-2"
          >
            ✨ Generate with AI
          </button>

          <small id="aiStatus" class="text-muted d-block mt-2"></small>
        </div>

        <div class="mb-3">
          <label for="image" class="form-lable">Upload Listing Image</label>
          <input
            type="file"
            name="listing[image]"
            class="form-control"
            required
          />
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lable">Price</label>
            <input
              name="listing[price]"
              placeholder="1200"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Price should be valid</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-lable">Country</label>
            <input
              type="text"
              name="listing[country]"
              placeholder="India"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Country name should be valid</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-lable">Location</label>
          <input
            type="text"
            name="listing[location]"
            placeholder="Jaipur, Rajasthan"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-3">
          <label class="form-label">Categories</label>

          <div class="row">
            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="trending"
                  id="trending"
                />
                <label class="form-check-label" for="trending">
                  🔥 Trending
                </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="rooms"
                  id="rooms"
                />
                <label class="form-check-label" for="rooms"> 🛏️ Rooms </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="iconic-cities"
                  id="iconic-cities"
                />
                <label class="form-check-label" for="iconic-cities">
                  🏙️ Iconic Cities
                </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="mountains"
                  id="mountains"
                />
                <label class="form-check-label" for="mountains">
                  ⛰️ Mountains
                </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="castles"
                  id="castles"
                />
                <label class="form-check-label" for="castles">
                  🏰 Castles
                </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="pools"
                  id="pools"
                />
                <label class="form-check-label" for="pools"> 🏊 Pools </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="camping"
                  id="camping"
                />
                <label class="form-check-label" for="camping">
                  ⛺ Camping
                </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="farms"
                  id="farms"
                />
                <label class="form-check-label" for="farms"> 🐄 Farms </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="arctic"
                  id="arctic"
                />
                <label class="form-check-label" for="arctic"> ❄️ Arctic </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="domes"
                  id="domes"
                />
                <label class="form-check-label" for="domes"> 🛖 Domes </label>
              </div>
            </div>

            <div class="col-md-4">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="listing[categories][]"
                  value="boats"
                  id="boats"
                />
                <label class="form-check-label" for="boats"> 🚤 Boats </label>
              </div>
            </div>
          </div>
        </div>

        <button class="btn btn-dark add-btn mt-3">Add</button>
        <br />
        <br />
      </form>
    </div>
  </div>
  <script src="/js/ai.js"></script>
</body>
