<% layout("/layouts/boilerplate") %>
<style>
  .filters {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    gap: 1.8rem;
    width: 100%;
    padding: 0.5rem 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: 0 0 auto !important;
    width: auto !important;
    min-width: 62px;
    margin: 1rem 0 0 0;
    padding: 0;
    text-align: center;
    opacity: 0.7;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .category-link {
    display: flex !important;
    flex-direction: column !important;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .category-link:hover {
    color: inherit;
  }

  .category-link p {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .tax-toggle {
    flex: 0 0 auto !important;
    margin-left: auto;
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 0.7rem 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .tax-info {
    display: none;
  }

  .category-link.active {
    opacity: 1;
    color: #fe424d;
    font-weight: 600;
  }

  .category-link.active i {
    transform: scale(1.1);
  }

  .sort-container {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.7rem;
  margin: 1rem 2rem;
}

.sort-container label {
  white-space: nowrap;
  font-size: 0.95rem;
}

.sort-container select {
  width: 220px;
  border-radius: 0.7rem;
}
</style>

<div class="container-fluid">
  <div class="filters">

  <a
    href="/listings?category=trending"
    class="filter category-link <%= selectedCategory === 'trending' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-fire"></i>
    </div>
    <p>Trending</p>
  </a>

  <a
    href="/listings?category=rooms"
    class="filter category-link <%= selectedCategory === 'rooms' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-bed"></i>
    </div>
    <p>Rooms</p>
  </a>

  <a
    href="/listings?category=iconic-cities"
    class="filter category-link <%= selectedCategory === 'iconic-cities' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-mountain-city"></i>
    </div>
    <p>Iconic Cities</p>
  </a>

  <a
    href="/listings?category=mountains"
    class="filter category-link <%= selectedCategory === 'mountains' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-mountain"></i>
    </div>
    <p>Mountains</p>
  </a>

  <a
    href="/listings?category=castles"
    class="filter category-link <%= selectedCategory === 'castles' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-brands fa-fort-awesome"></i>
    </div>
    <p>Castles</p>
  </a>

  <a
    href="/listings?category=pools"
    class="filter category-link <%= selectedCategory === 'pools' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-person-swimming"></i>
    </div>
    <p>Pools</p>
  </a>

  <a
    href="/listings?category=camping"
    class="filter category-link <%= selectedCategory === 'camping' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-campground"></i>
    </div>
    <p>Camping</p>
  </a>

  <a
    href="/listings?category=farms"
    class="filter category-link <%= selectedCategory === 'farms' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-cow"></i>
    </div>
    <p>Farms</p>
  </a>

  <a
    href="/listings?category=arctic"
    class="filter category-link <%= selectedCategory === 'arctic' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-snowflake"></i>
    </div>
    <p>Arctic</p>
  </a>

  <a
    href="/listings?category=domes"
    class="filter category-link <%= selectedCategory === 'domes' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-igloo"></i>
    </div>
    <p>Domes</p>
  </a>

  <a
    href="/listings?category=boats"
    class="filter category-link <%= selectedCategory === 'boats' ? 'active' : '' %>"
  >
    <div>
      <i class="fa-solid fa-ship"></i>
    </div>
    <p>Boats</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        id="switchCheckDefault"
      />

      <label
        class="form-check-label small"
        for="switchCheckDefault"
      >
        Display total after taxes
      </label>
    </div>
  </div>

</div>
</div> 

<div class="sort-container">
  <label for="sort">Sort by:</label>

  <select
    id="sort"
    class="form-select"
    onchange="applySort(this.value)"
  >
    <option value="">Recommended</option>
    <option
      value="price-asc"
      <%= selectedSort === "price-asc" ? "selected" : "" %>
    >
      Price: Low to High
    </option>

    <option
      value="price-desc"
      <%= selectedSort === "price-desc" ? "selected" : "" %>
    >
      Price: High to Low
    </option>

    <option
      value="newest"
      <%= selectedSort === "newest" ? "selected" : "" %>
    >
      Newest
    </option>

    <option
      value="title-asc"
      <%= selectedSort === "title-asc" ? "selected" : "" %>
    >
      Title: A → Z
    </option>
  </select>
</div>

    
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 listing-grid mt-3">

  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
  <div class="card col listing-card">

    <div class="card-img-wrapper">

      <img
        src="<%= listing.image.url %>"
        class="card-img-top"
        alt="Listing_image"
      />

      <div class="explore-overlay">
        <span>Explore stay →</span>
      </div>

    </div>

    <div class="card-body">

      <p class="card-title">
        <%= listing.title %>
      </p>

      <p class="card-location">
  <%= listing.location %>
</p>

      <p class="card-price">
        <span class="price">
          &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
        </span>

        <span class="tax-info">
          &#8377; <%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %>
          incl. taxes
        </span>
      </p>

    </div>

  </div>
</a>
  <% } %>

</div>


<!-- PAGINATION -->
<% if (totalPages > 1) { %>

  <div class="pagination-container">

    <% if (currentPage > 1) { %>

      <a
        href="/listings?page=<%= currentPage - 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= selectedSort ? '&sort=' + encodeURIComponent(selectedSort) : '' %>"
        class="pagination-btn"
      >
        ← Previous
      </a>

    <% } %>


    <% for (let i = 1; i <= totalPages; i++) { %>

      <a
        href="/listings?page=<%= i %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= selectedSort ? '&sort=' + encodeURIComponent(selectedSort) : '' %>"
        class="pagination-number <%= currentPage === i ? 'active' : '' %>"
      >
        <%= i %>
      </a>

    <% } %>


    <% if (currentPage < totalPages) { %>

      <a
        href="/listings?page=<%= currentPage + 1 %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= selectedSort ? '&sort=' + encodeURIComponent(selectedSort) : '' %>"
        class="pagination-btn"
      >
        Next →
      </a>

    <% } %>

  </div>

<% } %>


<script>
  let taxSwitch = document.getElementById("switchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    let prices = document.getElementsByClassName("price");

    for (let i = 0; i < taxInfo.length; i++) {
      if (taxSwitch.checked) {
        taxInfo[i].style.display = "inline";
        prices[i].style.display = "none";
      } else {
        taxInfo[i].style.display = "none";
        prices[i].style.display = "inline";
      }
    }
  });

  function applySort(sortValue) {
    const url = new URL(window.location.href);

    if (sortValue) {
      url.searchParams.set("sort", sortValue);
    } else {
      url.searchParams.delete("sort");
    }

    // When sorting changes, start from page 1
    url.searchParams.set("page", "1");

    window.location.href = url.toString();
  }
</script>

