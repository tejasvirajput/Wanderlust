<% layout("/layouts/boilerplate") %>

<style>
  /* ==========================================
     WANDERLUST ERROR PAGE
  ========================================== */

  .error-page {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
  }

  .error-card {
    width: 100%;
    max-width: 600px;
    text-align: center;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 1.25rem;
    padding: 2.5rem 2rem;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.07);
  }

  .error-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: #fff0f1;
    color: #fe424d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
  }

  .error-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .error-message {
    color: #717171;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .error-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fe424d;
    color: white;
    border: none;
    border-radius: 0.75rem;
    padding: 0.75rem 1.4rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .error-home-btn:hover {
    background: #e93642;
    color: white;
    transform: translateY(-1px);
  }

  @media (max-width: 576px) {
    .error-page {
      padding: 2rem 1rem;
    }

    .error-card {
      padding: 2rem 1.25rem;
      border-radius: 1rem;
    }

    .error-title {
      font-size: 1.4rem;
    }
  }
</style>

<div class="error-page">
  <div class="error-card">
    <div class="error-icon">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <h1 class="error-title">Something went wrong</h1>

    <p class="error-message"><%= message %></p>

    <a href="/listings" class="error-home-btn">
      <i class="fa-solid fa-arrow-left"></i>
      Back to Explore
    </a>
  </div>
</div>
