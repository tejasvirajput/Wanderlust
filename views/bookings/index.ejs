<% layout("/layouts/boilerplate") %>

<style>
  /* ==========================================
     MY BOOKINGS
  ========================================== */

  .bookings-page {
    max-width: 1200px;
  }

  .bookings-header {
    margin-bottom: 3rem;
  }

  .bookings-header h1 {
    font-size: 2.4rem;
    letter-spacing: -0.5px;
  }

  .bookings-header p {
    font-size: 1rem;
  }

  /* ==========================================
     EMPTY STATE
  ========================================== */

  .bookings-empty {
    border: 1px dashed #ddd;
    border-radius: 20px;
    background: #fafafa;
  }

  .bookings-empty-icon {
    font-size: 3rem;
    color: #fe424d;
  }

  .bookings-empty h3 {
    font-weight: 700;
  }

  .explore-btn {
    border-radius: 11px;
    padding: 0.7rem 1.2rem;
    font-weight: 600;
  }

  /* ==========================================
     BOOKING CARD
  ========================================== */

  .booking-card {
    border: 1px solid #eee !important;
    border-radius: 18px !important;
    overflow: hidden;
    background: #fff;
    transition: all 0.25s ease;
  }

  .booking-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1) !important;
  }

  .booking-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  .booking-card .card-body {
  padding: 1.25rem;
}

  .booking-title {
  font-size: 1.05rem;
  line-height: 1.35;
  margin-bottom: 0;
}

  /* ==========================================
   BOOKING DETAILS
========================================== */

.booking-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem 0.8rem;
  margin-top: 1.2rem;
}

.booking-detail {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.9rem;
}

.booking-detail-icon {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border-radius: 10px;
  background: rgba(254, 66, 77, 0.08);
  color: #fe424d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
}

.booking-detail-content {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.booking-detail-label {
  font-size: 0.68rem;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
}

.booking-detail-value {
  font-weight: 600;
  color: #222;
  font-size: 0.9rem;
}

  /* ==========================================
   TOTAL + STATUS
========================================== */

.booking-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #eee;
  margin-top: 1.2rem;
  padding-top: 1rem;
}

.booking-total-label {
  color: #666;
  font-size: 0.9rem;
}

.booking-total-price {
  font-size: 1.15rem;
  font-weight: 700;
  color: #222;
}

.booking-status {
  display: inline-flex !important;
  align-items: center;
  width: fit-content;
  margin-top: 0.9rem;
  padding: 0.42rem 0.7rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
}

  /* ==========================================
   CARD ACTIONS
========================================== */

.booking-card .card-footer {
  padding: 0 1.25rem 1.25rem;
}

.booking-action {
  border-radius: 11px;
  font-weight: 600;
  padding: 0.7rem 1rem;
  transition: all 0.2s ease;
}

.booking-action:hover {
  transform: translateY(-1px);
}

.cancel-booking-btn {
  transition: all 0.2s ease;
}

.booking-status {
  margin-top: 0.75rem;
  padding-bottom: 0.25rem;
}

.booking-status .badge {
  font-size: 0.8rem;
  padding: 0.5rem 0.75rem;
  border-radius: 999px;
}

  /* ==========================================
     MOBILE
  ========================================== */

@media (max-width: 767px) {

  .bookings-page {
    padding-top: 2rem !important;
  }

  .bookings-header h1 {
    font-size: 2rem;
  }

  .booking-image {
    height: 210px;
  }

  .booking-details {
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 0.6rem;
  }

}


/* ==========================================
   CANCEL BOOKING MODAL
========================================== */

.cancel-modal .modal-content {
  border: none;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
}

.cancel-modal .modal-dialog {
  max-width: 430px;
}

.cancel-modal .modal-footer .btn {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  border-radius: 11px;
  padding: 0.7rem 1rem;
  font-weight: 600;
}

.cancel-modal .modal-header {
  border: none;
  padding: 1.5rem 1.5rem 0.5rem;
}

.cancel-modal .modal-title {
  font-weight: 700;
  font-size: 1.25rem;
  color: #222;
}

.cancel-modal .modal-body {
  padding: 1rem 1.5rem 1.5rem;
}

.cancel-warning-icon {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  background: rgba(254, 66, 77, 0.1);
  color: #fe424d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.cancel-modal-message {
  color: #666;
  line-height: 1.6;
  margin-bottom: 0;
}

.cancel-modal .modal-footer {
  border: none;
  padding: 0 1.5rem 1.5rem;
  display: flex;
  gap: 0.75rem;
}

.cancel-modal .modal-footer .btn {
  flex: 1;
  border-radius: 11px;
  padding: 0.7rem 1rem;
  font-weight: 600;
}

.cancel-keep-btn {
  border: 1px solid #ddd;
  background: #fff;
  color: #222;
}

.cancel-keep-btn:hover {
  background: #f7f7f7;
}

.confirm-cancel-btn {
  background: #fe424d;
  border-color: #fe424d;
  color: #fff;
}

.confirm-cancel-btn:hover {
  background: #e93640;
  border-color: #e93640;
  color: #fff;
}

.confirm-cancel-btn:disabled {
  opacity: 0.7;
}
</style>


<div class="container py-5 bookings-page">

  <!-- ==========================================
       HEADER
  ========================================== -->

  <div class="bookings-header">

    <h1 class="fw-bold mb-2">
      My Bookings
    </h1>

    <p class="text-muted mb-0">
      View your upcoming and confirmed reservations.
    </p>

  </div>


  <% if (bookings.length === 0) { %>

    <!-- ==========================================
         EMPTY STATE
    ========================================== -->

    <div class="bookings-empty text-center py-5">

      <i class="fa-solid fa-calendar-xmark bookings-empty-icon"></i>

      <h3 class="mt-3">
        No bookings yet
      </h3>

      <p class="text-muted">
        You haven't made any reservations yet.
      </p>

      <a
        href="/listings"
        class="btn btn-danger explore-btn"
      >
        <i class="fa-solid fa-compass me-1"></i>
        Explore stays
      </a>

    </div>


  <% } else { %>

    <!-- ==========================================
         BOOKING CARDS
    ========================================== -->

    <div class="row g-4">

      <% bookings.forEach(booking => { %>

        <div class="col-md-6 col-lg-4">

          <div class="card booking-card shadow-sm h-100">

            <!-- Property Image -->

            <% if (booking.listing && booking.listing.image) { %>

              <img
                src="<%= booking.listing.image.url || booking.listing.image %>"
                class="booking-image"
                alt="<%= booking.listing.title || 'Property' %>"
              />

            <% } %>


            <!-- Booking Information -->

            <div class="card-body">

              <h5 class="booking-title fw-bold">

                <%= booking.listing
                  ? booking.listing.title
                  : "Property"
                %>

              </h5>


              <div class="booking-details">

                <!-- Check-in -->

                <div class="booking-detail">

                  <div class="booking-detail-icon">
                    <i class="fa-solid fa-calendar-plus"></i>
                  </div>

                  <div class="booking-detail-content">

                    <span class="booking-detail-label">
                      Check-in
                    </span>

                    <span class="booking-detail-value">

                      <%= new Date(
                        booking.checkIn
                      ).toLocaleDateString("en-IN") %>

                    </span>

                  </div>

                </div>


                <!-- Check-out -->

                <div class="booking-detail">

                  <div class="booking-detail-icon">
                    <i class="fa-solid fa-calendar-minus"></i>
                  </div>

                  <div class="booking-detail-content">

                    <span class="booking-detail-label">
                      Check-out
                    </span>

                    <span class="booking-detail-value">

                      <%= new Date(
                        booking.checkOut
                      ).toLocaleDateString("en-IN") %>

                    </span>

                  </div>

                </div>


                <!-- Guests -->

                <div class="booking-detail">

                  <div class="booking-detail-icon">
                    <i class="fa-solid fa-user-group"></i>
                  </div>

                  <div class="booking-detail-content">

                    <span class="booking-detail-label">
                      Guests
                    </span>

                    <span class="booking-detail-value">

                      <%= booking.guests %>

                    </span>

                  </div>

                </div>


                <!-- Nights -->

                <div class="booking-detail">

                  <div class="booking-detail-icon">
                    <i class="fa-solid fa-moon"></i>
                  </div>

                  <div class="booking-detail-content">

                    <span class="booking-detail-label">
                      Nights
                    </span>

                    <span class="booking-detail-value">

                      <%= booking.nights %>

                    </span>

                  </div>

                </div>

              </div>


              <!-- Total -->

              <div class="booking-total">

                <span class="booking-total-label">
                  Total price
                </span>

                <span class="booking-total-price">

                  ₹<%= booking.totalPrice.toLocaleString("en-IN") %>

                </span>

              </div>


              <!-- Status -->

              <% if (booking.status === "confirmed") { %>

                <div class="booking-status mb-3">
  <span class="badge bg-success">
    <i class="fa-solid fa-circle-check me-1"></i>
    Confirmed
  </span>
</div>

              <% } else if (booking.status === "cancelled") { %>

                <span class="badge bg-secondary booking-status">
                  Cancelled
                </span>

              <% } %>

            </div>


            <!-- Actions -->

            <% if (booking.listing) { %>

              <div class="card-footer bg-white border-0">

                <a
                  href="/listings/<%= booking.listing._id %>"
                  class="btn btn-outline-danger w-100 booking-action mb-2"
                >
                  View property
                  <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>


                <% if (
                  booking.status === "confirmed" &&
                  new Date() < new Date(booking.checkOut)
                ) { %>

                  <button
                    type="button"
                    class="btn btn-outline-dark w-100 booking-action cancel-booking-btn"
                    data-booking-id="<%= booking._id %>"
                    data-listing-id="<%= booking.listing._id %>"
                  >
                    Cancel booking
                  </button>

                <% } %>

              </div>

            <% } %>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</div>

<!-- ==========================================
     CANCEL BOOKING MODAL
========================================== -->

<div
  class="modal fade cancel-modal"
  id="cancelBookingModal"
  tabindex="-1"
  aria-labelledby="cancelBookingModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">

      <div class="modal-header">
        <h5
          class="modal-title"
          id="cancelBookingModalLabel"
        >
          Cancel reservation?
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <div class="modal-body">

        <div class="cancel-warning-icon">
          <i class="fa-solid fa-calendar-xmark"></i>
        </div>

        <p class="cancel-modal-message">
          Are you sure you want to cancel this reservation?
          This action cannot be undone.
        </p>

      </div>

      <div class="modal-footer">

        <button
          type="button"
          class="btn cancel-keep-btn"
          data-bs-dismiss="modal"
        >
          Keep booking
        </button>

        <button
          type="button"
          class="btn confirm-cancel-btn"
          id="confirmCancelBooking"
        >
          Yes, cancel
        </button>

      </div>

    </div>
  </div>
</div>

<script>
  // ==========================================
  // Cancel Booking - Custom Modal
  // ==========================================

  document.addEventListener("DOMContentLoaded", () => {

    const modalElement =
      document.getElementById("cancelBookingModal");

    const confirmButton =
      document.getElementById("confirmCancelBooking");

    const cancelButtons =
      document.querySelectorAll(".cancel-booking-btn");

    // Safety check
    if (!modalElement || !confirmButton || cancelButtons.length === 0) {
      console.error("Cancel booking elements not found.");
      return;
    }

    const cancelModal =
      new bootstrap.Modal(modalElement);

    let selectedButton = null;


    // ==========================================
    // Open Modal
    // ==========================================

    cancelButtons.forEach((button) => {

      button.addEventListener("click", () => {

        selectedButton = button;

        // Reset modal to original state
        document.getElementById(
          "cancelBookingModalLabel"
        ).textContent = "Cancel reservation?";

        document.querySelector(
          ".cancel-modal-message"
        ).textContent =
          "Are you sure you want to cancel this reservation? This action cannot be undone.";

        document.querySelector(
          ".cancel-warning-icon"
        ).innerHTML = `
          <i class="fa-solid fa-calendar-xmark"></i>
        `;

        confirmButton.disabled = false;

        confirmButton.innerHTML = `
          Yes, cancel
        `;

        cancelModal.show();

      });

    });


    // ==========================================
    // Confirm Cancellation
    // ==========================================

    confirmButton.addEventListener("click", async () => {

      if (!selectedButton) {
        return;
      }

      const bookingId =
        selectedButton.dataset.bookingId;

      const listingId =
        selectedButton.dataset.listingId;


      // Loading state
      confirmButton.disabled = true;

      confirmButton.innerHTML = `
        Cancelling...
        <i class="fa-solid fa-spinner fa-spin ms-1"></i>
      `;


      try {

        const response = await fetch(
          `/listings/${listingId}/bookings/${bookingId}/cancel`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json"
            }
          }
        );


        const responseText =
          await response.text();

        let data;


        try {

          data = JSON.parse(responseText);

        } catch (error) {

          throw new Error(
            `Server returned an unexpected response. Status: ${response.status}`
          );

        }


        if (!response.ok) {

          throw new Error(
            data.message ||
            "Unable to cancel the booking."
          );

        }


        // Close modal
        cancelModal.hide();


        // Reload page
        // Backend flash message will appear
        window.location.reload();


      } catch (error) {

        console.error(
          "CANCEL BOOKING ERROR:",
          error
        );


        // Show error inside modal
        document.getElementById(
          "cancelBookingModalLabel"
        ).textContent = "Cancellation failed";


        document.querySelector(
          ".cancel-modal-message"
        ).textContent =
          error.message ||
          "Something went wrong while cancelling your booking.";


        document.querySelector(
          ".cancel-warning-icon"
        ).innerHTML = `
          <i class="fa-solid fa-circle-exclamation"></i>
        `;


        confirmButton.disabled = false;

        confirmButton.innerHTML = `
          Try again
        `;

      }

    });

  });
</script>